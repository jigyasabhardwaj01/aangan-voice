# ── Aangan voice enquiry system — copy to .env.local (local) or set in Vercel → Settings → Environment Variables.
# Secrets are read server-side only. Nothing here is prefixed NEXT_PUBLIC_, so none reach the browser.

# ── App ────────────────────────────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000          # used for dashboard links in Telegram/HubSpot (set to your Vercel URL)
STUDIO_TIMEZONE=Asia/Kolkata
# Front-desk hours. Source says "10am to 7pm"; it does not say which days. Default Mon–Sat (0=Sun … 6=Sat) — CONFIRM with Nikhil.
HUMAN_HOURS_START=10
HUMAN_HOURS_END=19
HUMAN_DAYS=1,2,3,4,5,6
RESPONSE_TARGET_SECONDS=300
CALLBACK_SLA_MINUTES=60                     # follow-up task due time for missed/incomplete/failed-booking leads
CALLBACK_PROMISE_TEXT=within the hour       # what the agent tells callers when a human will call back — CONFIRM it is staffed overnight
ESCALATION_SLA_MINUTES=15                   # complaint callback task due time
ESCALATION_OWNER_NAME=Nikhil Deshpande
DEMO_MODE=false                             # true: replay the 20 anonymised September calls into an in-memory store (never in production)

# ── Dashboard auth (required) ──────────────────────────────────────────────────────────────────────
SESSION_SECRET=                             # 32+ random chars:  openssl rand -base64 32
# JSON array. Roles: "owner" (everything incl. costs & integration health) or "designer" (leads, review, bookings, pricing guidance).
# Generate each hash with:  npm run hash-password -- 'the-password'
DASHBOARD_USERS=[{"email":"nikhil@example.com","role":"owner","hash":"scrypt:..."},{"email":"designer@example.com","role":"designer","hash":"scrypt:..."}]

# ── Supabase (database) ────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                  # server-only. Never expose. Run supabase/migrations/0001_init.sql first.

# ── Vaani Labs (voice agent) ───────────────────────────────────────────────────────────────────────
VAANI_WEBHOOK_SECRET=                       # signs webhooks (HMAC-SHA256 of raw body; see src/domain/webhooks/signature.ts — VERIFY vs Vaani docs)
VAANI_SIGNATURE_HEADER=x-vaani-signature
VOICE_TOOL_SECRET=                          # bearer secret Vaani sends to /api/voice/tools/* and /api/voice/route
ALLOW_UNSIGNED_WEBHOOKS=false               # local testing only
VAANI_COST_PER_MIN=                         # optional: if set (and Vaani doesn't report cost), voice cost is shown as an ESTIMATE
VAANI_COST_CURRENCY=INR

# ── Cal.com (calendar) ─────────────────────────────────────────────────────────────────────────────
CAL_API_KEY=                                # cal_live_…
CAL_EVENT_TYPE_ID=                          # numeric id of the "Design consultation" event type (hosts = designers)
CAL_EVENT_DURATION_MIN=60                   # fallback if slots response lacks an end time
CAL_MIN_NOTICE_HOURS=12                     # don't offer slots sooner than this
CAL_REQUIRE_EMAIL=true                      # agent asks for an email for the invite; set false to allow phone-only attendees
CAL_DEFAULT_DESIGNER=                       # shown if Cal.com returns no host name
# CAL_API_BASE=https://api.cal.com/v2  CAL_SLOTS_API_VERSION=2024-09-04  CAL_BOOKINGS_API_VERSION=2026-02-25

# ── Gemini Flash (post-call summary & extraction) ──────────────────────────────────────────────────
GEMINI_API_KEY=                             # optional: without it a deterministic (non-AI) summary is produced and labelled as such
GEMINI_MODEL=gemini-2.5-flash
GEMINI_INPUT_RATE_PER_M=                    # optional price per 1M input tokens  → Gemini cost shown as ESTIMATED; blank = UNKNOWN
GEMINI_OUTPUT_RATE_PER_M=
GEMINI_RATE_CURRENCY=USD

# ── HubSpot (CRM) ──────────────────────────────────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=                       # private-app token with crm.objects.contacts/deals read+write
HUBSPOT_PIPELINE_ID=
HUBSPOT_DEAL_STAGE_ID=
HUBSPOT_REVIEW_POLICY=require_approval      # require_approval (default): AMBER leads sync only after a designer approves | auto

# ── Telegram (alerts) ──────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_DESIGNER_CHAT_ID=                  # designer handoff group
TELEGRAM_ESCALATION_CHAT_ID=                # the designated human owner for existing-client complaints (no silent fallback)

# ── Jobs / cron ────────────────────────────────────────────────────────────────────────────────────
CRON_SECRET=                                # Vercel Cron sends it automatically as a Bearer token to /api/cron/jobs
MAX_JOB_ATTEMPTS=6
